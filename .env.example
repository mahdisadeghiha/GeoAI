# Application
APP_NAME=GeoAI Urban Change Detection
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostGIS)
DATABASE_URL=postgresql+psycopg2://geoai:geoai@localhost:5432/geoai_change

# Data paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
SAMPLES_DATA_DIR=./data/samples

# Study area (Muscat, Oman) — WGS84 bbox: west,south,east,north
STUDY_AREA_NAME=Muscat, Oman
STUDY_AREA_BBOX=58.35,23.50,58.65,23.65
TARGET_CRS=EPSG:32640

# Change detection parameters
CHANGE_THRESHOLD_SIGMA=2.0
MIN_CHANGE_REGION_AREA_M2=1000
NDVI_EPS=1e-8

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
